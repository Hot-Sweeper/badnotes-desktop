COMET_API_KEY=
COMET_API_BASE=https://api.cometapi.com/v1
# Optional HTTPS iCalendar feed. Empty means no calendar requests.
BADNOTES_CALENDAR_URL=
BADNOTES_CALENDAR_TIMEZONE=UTC
